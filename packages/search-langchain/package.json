{
  "name": "@iflow-ai/search-langchain",
  "version": "0.1.0-pre.0",
  "description": "LangChain JS tool factories for the iFlow Search API (web search, image search, web fetch). Built on @iflow-ai/search-core.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengyanglsun/iflow-search-js.git",
    "directory": "packages/search-langchain"
  },
  "bugs": {
    "url": "https://github.com/zhengyanglsun/iflow-search-js/issues"
  },
  "homepage": "https://github.com/zhengyanglsun/iflow-search-js/tree/main/packages/search-langchain#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "iflow",
    "iflow-search",
    "langchain",
    "langchainjs",
    "langgraph",
    "tool",
    "agent",
    "web-search",
    "image-search",
    "web-fetch"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@iflow-ai/search-core": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0 || ^1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^0.3.66",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "zod": "^3.25.0"
  }
}
