{
  "name": "@iflow-examples/langgraph-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Example: a LangGraph React agent that uses @iflow-ai/search-langchain tools. Not a published package.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@iflow-ai/search-core": "workspace:*",
    "@iflow-ai/search-langchain": "workspace:*",
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.3.0",
    "zod": "^3.25.32"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
